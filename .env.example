APP_NAME="Aeroporto Reggio Calabria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aeroportoreggiocalabria.it
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=aeroportorc_db
DB_USERNAME=aeroportorc_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.aeroportoreggiocalabria.it
MAIL_PORT=587
MAIL_USERNAME=noreply@aeroportoreggiocalabria.it
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@aeroportoreggiocalabria.it"
MAIL_FROM_NAME="${APP_NAME}"

# AviationStack API — registrati gratis su https://aviationstack.com
# Piano free: 100 chiamate/mese | Piano basic: 10.000/mese (9,99$/mese)
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# Aeroporto IATA code
AIRPORT_IATA=REG

# Open-Meteo (meteo gratuito, nessuna chiave richiesta)
WEATHER_LAT=38.0718
WEATHER_LON=15.6515

# Filament Admin
FILAMENT_DOMAIN=admin.aeroportoreggiocalabria.it
