APP_NAME="Aeroporto Reggio Calabria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aeroportoreggiocalabria.it
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=aeroportorc_db
DB_USERNAME=aeroportorc_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mail.aeroportoreggiocalabria.it
MAIL_PORT=587
MAIL_USERNAME=noreply@aeroportoreggiocalabria.it
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@aeroportoreggiocalabria.it"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────
# VOLI IN TEMPO REALE — AviationStack
# Registrati su https://aviationstack.com
#   Piano FREE  : 100 chiamate/mese, solo HTTP  → test locale
#   Piano BASIC : 10.000/mese a $9.99/mese      → produzione consigliato
#   Piano PRO   : 50.000/mese a $49.99/mese     → traffico elevato
#
# NOTA: il piano FREE usa HTTP (non HTTPS). In produzione con HTTPS
# attivo, devi avere almeno il piano BASIC per usare HTTPS nell'URL.
# ─────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────
# APPROCCIO IBRIDO: gli orari vengono dal DB, l'API serve solo
# per aggiornare stato e ritardi (chiamata 1 volta/ora per tipo).
#
# PROVIDER CONSIGLIATO: AirLabs — 1.000 chiamate/mese GRATIS
#   Registrazione: https://airlabs.co  (piano Free, nessuna carta)
#   Con cache 60 min → ~720 chiamate/mese, sempre nel free tier.
#
# PROVIDER ALTERNATIVO: AviationStack (fallback automatico)
#   https://aviationstack.com — piano Basic $9.99/mese
# ─────────────────────────────────────────────────────────────────
AIRLABS_API_KEY=                 # ← Consigliato (gratuito)

AVIATIONSTACK_API_KEY=           # ← Fallback (opzionale, a pagamento)
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# Cache del feed voli in secondi. Due ore producono circa 720 richieste/mese
# per arrivi + partenze e lasciano margine nel piano gratuito AirLabs.
FLIGHT_STATUS_CACHE_TTL=7200

# Aeroporto IATA code
AIRPORT_IATA=REG

# Open-Meteo (meteo gratuito, nessuna chiave richiesta)
WEATHER_LAT=38.0718
WEATHER_LON=15.6515

# Filament Admin
FILAMENT_DOMAIN=admin.aeroportoreggiocalabria.it
